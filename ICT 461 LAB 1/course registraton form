<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Course Registration</title>
<style>
  :root {
    --ink: #1c2430;
    --paper: #f6f4ee;
    --card: #ffffff;
    --line: #d8d2c4;
    --accent: #2f5233;
    --accent-soft: #eaf0e7;
    --error: #9a2b2b;
    --error-soft: #fbecec;
    font-size: 16px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    display: flex;
    justify-content: center;
    padding: 48px 20px;
  }

  main {
    width: 100%;
    max-width: 480px;
  }

  .kicker {
    font-family: Verdana, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 6px;
  }

  h1 {
    font-size: 1.7rem;
    line-height: 1.25;
    margin: 0 0 6px;
  }

  .lede {
    font-family: Verdana, sans-serif;
    font-size: 0.9rem;
    color: #58605c;
    margin: 0 0 28px;
    line-height: 1.5;
  }

  form {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 32px;
  }

  fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  legend {
    padding: 0;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  header {
    margin-bottom: 28px;
  }

  @media (max-width: 400px) {
    body { padding: 24px 14px; }
    form { padding: 22px; }
  }

  .field {
    margin-bottom: 22px;
  }

  .field:last-of-type {
    margin-bottom: 0;
  }

  label {
    display: block;
    font-family: Verdana, sans-serif;
    font-size: 0.82rem;
    font-weight: bold;
    margin-bottom: 6px;
  }

  .hint {
    font-family: Verdana, sans-serif;
    font-size: 0.76rem;
    color: #72776f;
    margin: 4px 0 0;
  }

  input, select {
    width: 100%;
    padding: 10px 11px;
    font-family: Verdana, sans-serif;
    font-size: 0.92rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid #b7b0a0;
    border-radius: 3px;
  }

  input:focus-visible, select:focus-visible, button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  input:invalid:not(:placeholder-shown), select:invalid {
    border-color: var(--error);
  }

  .error-msg {
    display: none;
    font-family: Verdana, sans-serif;
    font-size: 0.78rem;
    color: var(--error);
    background: var(--error-soft);
    padding: 6px 9px;
    border-radius: 3px;
    margin-top: 6px;
  }

  .field.invalid .error-msg {
    display: block;
  }

  .field.invalid input,
  .field.invalid select {
    border-color: var(--error);
  }

  button {
    margin-top: 8px;
    width: 100%;
    padding: 12px;
    font-family: Verdana, sans-serif;
    font-size: 0.92rem;
    font-weight: bold;
    color: #fff;
    background: var(--accent);
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }

  button:hover { background: #274429; }

  #formStatus {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 3px;
    font-family: Verdana, sans-serif;
    font-size: 0.85rem;
    display: none;
  }

  #formStatus.success {
    display: block;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid #b8ccb4;
  }

  @media (prefers-reduced-motion: no-preference) {
    .field.invalid .error-msg { animation: fade-in 0.15s ease-out; }
  }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
</style>
</head>
<body>
<main>
  <header>
    <p class="kicker">ICT461 &middot; Registration</p>
    <h1>Course Registration</h1>
    <p class="lede">Fields marked required must be completed before the form can be submitted.</p>
  </header>

  <form id="registrationForm" method="post" action="/register" novalidate>
   <fieldset>
    <legend>Registration details</legend>

    <div class="field" data-field="fullName">
      <label for="fullName">Full name</label>
      <input
        type="text"
        id="fullName"
        name="fullName"
        autocomplete="name"
        minlength="3"
        maxlength="80"
        required
      >
      <p class="error-msg" role="alert"></p>
    </div>

    <div class="field" data-field="studentId">
      <label for="studentId">Student ID</label>
      <input
        type="text"
        id="studentId"
        name="studentId"
        inputmode="text"
        autocomplete="off"
        pattern="^{2,4}[0-9]{4,8}$"
        placeholder="e.g. 2023xxxxx"
        required
      >
      <p class="error-msg" role="alert"></p>
    </div>

    <div class="field" data-field="programme">
      <label for="programme">Programme</label>
      <select id="programme" name="programme" required>
        <option value="" disabled selected>Select your programme</option>
        <option value="bsc-cs">BSc Computer Science</option>
        <option value="bsc-it">BSc Information Technology</option>
        <option value="bsc-se">BSc Software Engineering</option>
        <option value="bsc-ds">BSc Data Science</option>
        <option value="other">Other</option>
      </select>
      <p class="error-msg" role="alert"></p>
    </div>

    <div class="field" data-field="course">
      <label for="course">Course code</label>
      <input
        type="text"
        id="course"
        name="course"
        autocomplete="off"
        pattern="^[A-Za-z]{2,4}[0-9]{3}$"
        placeholder="e.g. ICT461"
        required
      >
      <p class="hint">Department code plus three digits (e.g. ICT461).</p>
      <p class="error-msg" role="alert"></p>
    </div>
   </fieldset>

    <button type="submit">Register</button>
    <div id="formStatus" role="status"></div>
  </form>
</main>

<script>
  const form = document.getElementById('registrationForm');
  const status = document.getElementById('formStatus');

  const messages = {
    fullName: {
      valueMissing: 'Enter your full name.',
      tooShort: 'Name must be at least 3 characters.'
    },
    studentId: {
      valueMissing: 'Enter your student ID.',
      patternMismatch: 'Use letters followed by digits, e.g. CS202301234.'
    },
    programme: {
      valueMissing: 'Select a programme.'
    },
    course: {
      valueMissing: 'Enter the course code.',
      patternMismatch: 'Use a department code plus three digits, e.g. ICT461.'
    }
  };

  function messageFor(input) {
    const v = input.validity;
    const set = messages[input.name] || {};
    if (v.valueMissing) return set.valueMissing || 'This field is required.';
    if (v.tooShort) return set.tooShort || 'Too short.';
    if (v.patternMismatch) return set.patternMismatch || 'Please match the requested format.';
    return input.validationMessage || 'Please check this field.';
  }

  function showError(input) {
    const fieldEl = input.closest('.field');
    fieldEl.classList.add('invalid');
    fieldEl.querySelector('.error-msg').textContent = messageFor(input);
  }

  function clearError(input) {
    const fieldEl = input.closest('.field');
    if (input.checkValidity()) {
      fieldEl.classList.remove('invalid');
      fieldEl.querySelector('.error-msg').textContent = '';
    }
  }

  form.querySelectorAll('input, select').forEach((input) => {
    input.addEventListener('invalid', (e) => {
      e.preventDefault();
      showError(input);
    });
    input.addEventListener('input', () => clearError(input));
    input.addEventListener('change', () => clearError(input));
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let firstInvalid = null;
    form.querySelectorAll('input, select').forEach((input) => {
      if (!input.checkValidity()) {
        showError(input);
        if (!firstInvalid) firstInvalid = input;
      }
    });

    if (firstInvalid) {
      firstInvalid.focus();
      status.className = '';
      status.textContent = '';
      return;
    }

    // In production this would submit to /register on the server.
    status.textContent = 'Client-side checks passed. Ready to submit to the server.';
    status.className = 'success';
  });
</script>
</body>
</html>